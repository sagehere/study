          [
            "last",
            "只对照最终答案，不同就改最后一步"
          ]
        ]
      },
      "transitions": [
        {
          "when": "rule",
          "to": "independent",
          "effects": [
            {
              "type": "setFlag",
              "key": "formalized",
              "value": true
            },
            {
              "type": "emit",
              "event": "FORMALIZATION_UNLOCKED",
