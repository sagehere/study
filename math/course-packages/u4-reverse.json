      "transitions": [
        {
          "when": "muldiv",
          "to": "firstError",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U4-REVERSE-01"
            },
            {
              "type": "scheduleReview",
              "reason": "mixed-operation-order"
            }
          ]
        }
      ]
