        "prompt": "算式440－200÷5×8，第一步应该算什么？",
        "choices": [
          [
            "divide",
            "200÷5"
          ],
          [
            "subtract",
            "440－200"
          ],
          [
            "multiply",
            "5×8"
          ]
        ]
      },
      "transitions": [
        {
          "when": "divide",
          "to": "firstError",
          "effects": [
            {
              "type": "markObjective",
              "stage": "diagnostic_success"
            }
          ]
