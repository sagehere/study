          ],
          [
            "last",
            "最后440－5"
          ],
          [
            "answer",
            "只看答案435"
          ]
        ]
      },
      "transitions": [
        {
          "when": "first",
          "to": "repairFlow",
          "effects": [
            {
              "type": "markObjective",
              "stage": "guided_success"
