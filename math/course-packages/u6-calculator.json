          [
            "whole",
            "一个要先求出的整体"
          ],
          [
            "separate",
            "两个可分别和128运算的数"
          ]
        ]
      },
      "transitions": [
        {
          "when": "whole",
          "to": "ce",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U6-CALC-02"
            },
            {
              "type": "scheduleReview",
              "reason": "calculator-bracket-order"
            }
          ]
        }
      ]
    },
