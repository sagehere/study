      },
      "transitions": [
        {
          "when": "check",
          "to": "formalize",
          "effects": [
            {
              "type": "markObjective",
              "stage": "guided_success"
            }
          ]
        },
        {
          "when": "trust",
          "to": "repairTrust",
          "lane": "repair",
          "effects": [
            {
              "type": "markMisconception",
              "id": "M-U6-CALC-03",
              "confidence": "high"
            }
          ]
        }
      ]
