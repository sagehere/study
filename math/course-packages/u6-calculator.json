      "transitions": [
        {
          "when": "estimate",
          "to": "formalize",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U6-CALC-03"
            },
            {
              "type": "scheduleReview",
              "reason": "calculator-estimate-check"
            }
          ]
        }
      ]
