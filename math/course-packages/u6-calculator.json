        "prompt": "已经正确输入123＋，错的是455。最少要重做哪一部分？",
        "choices": [
          [
            "current",
            "只重输当前的456"
          ],
          [
            "all",
            "全部从头"
          ]
        ]
      },
      "transitions": [
        {
          "when": "current",
          "to": "verify",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U6-CALC-04"
