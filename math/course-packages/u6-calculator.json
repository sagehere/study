      "view": {
        "title": "计算器不会替你审题",
        "prompt": "为什么不能把题目从左到右机械输入？",
        "choices": [
          [
            "order",
            "因为必须遵守原算式的运算顺序和括号结构"
          ],
          [
            "keys",
            "因为按键太多"
          ]
        ]
      },
      "transitions": [
        {
          "when": "order",
          "to": "bracket",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U6-CALC-01"
            },
            {
              "type": "scheduleReview",
              "reason": "calculator-plan-before-input"
            }
          ]
        }
      ]
    },
    "bracket": {
      "objectiveId": "O-U6-CALC-02",
      "hints": [
        "",
        "括号先形成整体。",
        "41600和640先相加。",
        "得到42240。",
        "再用42240÷128。"
