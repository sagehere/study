            {
              "type": "scheduleReview",
              "reason": "calculator-correct-current-entry"
            }
          ]
        }
      ]
    },
    "verify": {
      "objectiveId": "O-U6-CALC-04",
      "hints": [
        "",
        "估算能发现输错位数或运算符。",
        "3928接近4000。",
        "4000×50约20万。",
        "196400在合理范围，而且小于20万。"
