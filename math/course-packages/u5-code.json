      "transitions": [
        {
          "when": "correct",
          "to": "fixedWidth",
          "effects": [
            {
              "type": "markObjective",
              "stage": "guided_success"
            }
          ]
        },
        {
          "when": "wrong",
          "to": "repairSegment",
          "lane": "repair",
          "effects": [
            {
              "type": "markMisconception",
              "id": "M-U5-CODE-02",
