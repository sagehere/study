  },
  "objectives": {
    "meaning": "O-U5-CODE-01",
    "segment": "O-U5-CODE-02",
    "fixedWidth": "O-U5-CODE-03",
    "transfer": "O-U5-CODE-04"
  },
  "misconceptions": {
