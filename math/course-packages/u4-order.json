          [
            "left",
            "最左边的运算，不分级"
          ],
          [
            "sub",
            "减法"
          ]
        ]
      },
      "transitions": [
        {
          "when": "muldiv",
          "to": "sameLevel",
          "effects": [
            {
              "type": "markObjective",
              "stage": "diagnostic_success"
            }
          ]
