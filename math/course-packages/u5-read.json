      },
      "transitions": [
        {
          "when": "correct",
          "to": "middleZero",
          "effects": [
            {
              "type": "markObjective",
              "stage": "guided_success"
            }
          ]
        },
        {
          "when": "all",
          "to": "repairZero",
          "lane": "repair",
          "effects": [
            {
              "type": "markMisconception",
              "id": "M-U5-READ-02",
              "confidence": "high"
            }
          ]
