        "renderer": "placeValueGroups",
        "rendererArgs": {
          "value": "30800007",
          "label": "30800007按万级3080和个级0007分组，中间连续零只读一个"
        }
      },
      "transitions": [
        {
          "when": "correct",
          "to": "formalize",
          "effects": [
            {
              "type": "markObjective",
              "stage": "guided_success"
