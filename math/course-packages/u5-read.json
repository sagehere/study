          "effects": [
            {
              "type": "markMisconception",
              "id": "M-U5-READ-03",
              "confidence": "high"
            }
          ]
        }
      ]
    },
    "repairOmit": {
      "objectiveId": "O-U5-READ-02",
      "hints": [
        "",
        "读数要保留位值结构。",
        "个级是0007。",
        "从万级过渡到个位7时，中间缺位需要一个“零”。",
        "连续几个0只读一个零。"
      ],
      "view": {
        "title": "为什么这里不能完全不读零",
        "prompt": "如果不读零，“三千八十万七”会让7听起来落在哪个数位附近？",
        "choices": [
          [
            "wrong",
            "会丢失中间数位信息"
          ],
          [
            "fine",
            "完全没有影响"
          ]
        ]
      },
      "transitions": [
        {
          "when": "wrong",
          "to": "formalize",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U5-READ-03"
            },
            {
              "type": "scheduleReview",
              "reason": "middle-zero-reading"
            }
          ]
        }
      ]
