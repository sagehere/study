  "labels": {
    "badge": "数位表征正式课",
    "title": "读数、写数与零",
    "description": "先按“四位一级”分级，再判断每一级里的零是否需要读出。"
  },
  "objectives": {
    "group": "O-U5-READ-01",
    "zero": "O-U5-READ-02",
    "write": "O-U5-READ-03",
    "transfer": "O-U5-READ-04"
  },
  "misconceptions": {
    "digitByDigit": "M-U5-READ-01",
