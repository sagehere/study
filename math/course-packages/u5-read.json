      "transitions": [
        {
          "when": "silent",
          "to": "middleZero",
          "effects": [
            {
              "type": "resolveMisconception",
              "id": "M-U5-READ-02"
            },
            {
              "type": "scheduleReview",
              "reason": "group-trailing-zero-reading"
            }
          ]
        }
      ]
    },
    "middleZero": {
      "objectiveId": "O-U5-READ-02",
      "hints": [
        "",
        "分成3080｜0007。",
        "万级3080读三千零八十万。",
        "个级前面连续有0直到7，需要读一个零。",
