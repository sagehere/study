      ],
      "view": {
        "title": "中间的连续零只读一个",
        "prompt": "30800007 读作哪一个？",
        "choices": [
          [
            "correct",
            "三千零八十万零七"
          ],
          [
            "none",
            "三千八十万七"
          ],
          [
            "many",
            "三千零零八十万零零零七"
          ]
